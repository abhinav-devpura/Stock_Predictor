# Copy to `.env` and fill in. `.env` is git-ignored; never commit real values.

# SEC EDGAR requires a descriptive User-Agent with a contact address on every
# request. Set this to your own name/email before running any EDGAR-backed
# script (fundamentals, filing text, insider). A shared/placeholder UA may be
# throttled. If unset, config.py falls back to a placeholder.
EDGAR_USER_AGENT="your-name research you@example.com"

# Only needed for the legacy predict_stock.py Reddit-sentiment demo — NOT for
# the current factor pipeline or the dashboard. Get these from
# https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="stock-predictor sentiment by u/yourname"
